# Sentry CLI config — TEMPLATE (committed).
#
# Copy this file to `.sentryclirc` (which is gitignored) and paste your auth
# token. The Archive build phase uses it to upload dSYMs so App Hang / crash
# stack traces symbolicate in Sentry (see RIVULET-41).
#
#   cp .sentryclirc.template .sentryclirc
#   # then edit .sentryclirc and set token=...
#
# Create the token at:
#   https://g-studios-xc.sentry.io/settings/auth-tokens/
# Required scopes: project:read, project:releases, project:write
# (the "Source Maps / Debug Files upload" preset covers these).
#
# NEVER commit the real token. `.sentryclirc` is in .gitignore.

[auth]
token=YOUR_SENTRY_AUTH_TOKEN_HERE

[defaults]
org=g-studios-xc
project=rivulet
