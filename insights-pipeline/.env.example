# Insights pipeline configuration. Copy to .env and fill in.
# This file is committed to a PUBLIC repo: it must contain NO real secrets,
# tokens, hostnames, or account ids — only placeholders and safe defaults.

# ── Local LLM (OpenAI-compatible endpoint; Ollama). Point at your Ollama host.
#    In a container reaching an Ollama on the Docker host, use
#    http://host.docker.internal:11434/v1 (the compose file maps host-gateway). ──
INSIGHTS_LLM_BASE_URL=http://YOUR_OLLAMA_HOST:11434/v1
INSIGHTS_LLM_MODEL=gemma4:31b-it-q4_K_M
INSIGHTS_LLM_TIMEOUT_SECS=400
INSIGHTS_LLM_MAX_RETRIES=2
# Per-stage models: extract needs the strong (spoiler-safe) model; verify runs a
# faster model for grounding + category only (spoiler is CARRIED from extract,
# never re-derived by the fast model).
INSIGHTS_EXTRACT_MODEL=gemma4:31b-it-q4_K_M
INSIGHTS_VERIFY_MODEL=qwen3:8b

# ── TMDB via the public proxy Worker (no TMDB key lives on this box). ──
INSIGHTS_TMDB_PROXY_BASE_URL=https://tmdb-proxy.baingurley.workers.dev

# ── Seed scope. Leave false = popular-only (no Plex, no token, ever). Set true
#    only to intersect with a Plex library, then fill INSIGHTS_PLEX_* below. ──
INSIGHTS_LIBRARY_ONLY=false
INSIGHTS_PLEX_BASE_URL=
INSIGHTS_PLEX_TOKEN=

# ── R2 (S3 API). REQUIRED for the worker container: the on-demand queue
#    (LIST/DELETE under requests/pending/) and unattended publish both use the
#    S3 API — a headless container has no wrangler OAuth session. Create an R2
#    API token (Object Read & Write) in the Cloudflare dashboard; the endpoint is
#    https://<account_id>.r2.cloudflarestorage.com.
#    (For an interactive box run instead of the container, you can leave these
#    blank and publish will use wrangler's own OAuth session.) ──
INSIGHTS_R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
INSIGHTS_R2_BUCKET=rivulet-insights
INSIGHTS_R2_ACCESS_KEY_ID=
INSIGHTS_R2_SECRET_ACCESS_KEY=

# ── Data dir (mount a volume here): manifest, seed scratch, worker.lock. ──
INSIGHTS_DATA_DIR=/app/data

# ── On-demand loop + scheduling cadence (safe defaults; override to tune). ──
INSIGHTS_ONDEMAND_POLL_SECS=120       # idle sleep between on-demand queue polls
INSIGHTS_ONDEMAND_MAX_BATCH=8         # max titles processed per on-demand drain
INSIGHTS_SCHEDULED_MAX_TITLES=200     # cap per scheduled seed pass
INSIGHTS_RESEED_INTERVAL_SECS=21600   # how often the scheduled seed re-evaluates stale/new/popular (6h)

# ── Age-aware freshness: young titles (still accreting coverage) re-scrape on
#    the young interval until past the settle window, then drop to the mature TTL. ──
INSIGHTS_SETTLE_MOVIE_DAYS=90
INSIGHTS_SETTLE_SHOW_DAYS=60
INSIGHTS_SETTLE_EPISODE_DAYS=30
INSIGHTS_YOUNG_REFRESH_DAYS=14
INSIGHTS_TTL_MOVIE_DAYS=180
INSIGHTS_TTL_SHOW_DAYS=45
INSIGHTS_TTL_EPISODE_DAYS=90
