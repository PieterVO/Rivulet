# LLM (OpenAI-compatible endpoint; Ollama on the Unraid box by default)
INSIGHTS_LLM_BASE_URL=http://your-ollama-host:11434/v1
INSIGHTS_LLM_MODEL=gemma4:31b-it-q4_K_M
INSIGHTS_LLM_TIMEOUT_SECS=400
INSIGHTS_LLM_MAX_RETRIES=2

# Stage on-disk data dir
INSIGHTS_DATA_DIR=./data

# TMDB access via the existing tmdb-proxy Worker
INSIGHTS_TMDB_PROXY_BASE_URL=https://tmdb-proxy.baingurley.workers.dev

# Plex library dump (server on the same box in prod)
INSIGHTS_PLEX_BASE_URL=
INSIGHTS_PLEX_TOKEN=

# Cloudflare R2. The publish stage's default uploader shells out to
# `wrangler r2 object put ... --remote` (wrangler is already OAuth-authed on
# the box, so no access-key credentials are required) — only INSIGHTS_R2_BUCKET
# is used for that path (defaults to "rivulet-insights" if unset).
# The remaining vars are only needed for the boto3 S3-compatible fallback
# uploader (Config.r2_configured), if/when an R2 API token exists.
INSIGHTS_R2_BUCKET=rivulet-insights
INSIGHTS_R2_ENDPOINT_URL=
INSIGHTS_R2_ACCESS_KEY_ID=
INSIGHTS_R2_SECRET_ACCESS_KEY=
